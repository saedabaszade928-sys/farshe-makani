opacity:.92;

margin-bottom:28px;

}

.btn{

display:block;

width:100%;

margin:14px 0;

padding:18px;

border-radius:18px;

background:#d4af37;

color:#081631;

font-size:18px;

font-weight:700;

text-decoration:none;

transition:.3s;

}

.btn:hover{

transform:scale(1.04);

}

.address{

margin-top:25px;

line-height:2;

font-size:16px;

color:#ddd;

}

.copy{

margin-top:28px;

